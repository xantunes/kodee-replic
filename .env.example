# ═══════════════════════════════════════════════════════════════
# Kodee API — Environment Configuration Example
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── LLM Provider: Kimi (Moonshot AI) ─────────────────────────
OPENAI_API_KEY=sk-your-kimi-key-here
OPENAI_API_BASE=https://api.moonshot.ai/v1
MODEL=kimi-k2.6

# Agent-specific model overrides (optional)
MODEL_ROUTER=kimi-k2.6
MODEL_DNS=kimi-k2.6
MODEL_BACKUP=kimi-k2.6
MODEL_MONITORING=kimi-k2.6
MODEL_HANDOFF=kimi-k2.6

# ─── FortiGate MCP Integration ────────────────────────────────
FORTIOS_HOST=https://10.2.100.93
FORTIOS_API_TOKEN=your-fortigate-token-here
FORTIOS_VERIFY_SSL=false
FORTIOS_READONLY=true

# FortiGate Governance (optional)
# FORTIOS_DRY_RUN=false
# FORTIOS_CHANGE_TOKEN=
# FORTIOS_OPERATOR_TOKEN=
# FORTIOS_APPROVER_TOKEN=
# FORTIOS_EMERGENCY_TOKEN=
# FORTIOS_CHANGE_WINDOW=

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kodee

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant (RAG Vector DB) ───────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
JAEGER_ENDPOINT=http://localhost:4317

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_RPS=10

# ─── MCP Server ───────────────────────────────────────────────
MCP_SERVER_NAME=kodee-mcp
MCP_SERVER_VERSION=0.1.0
