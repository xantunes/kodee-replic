# ═══════════════════════════════════════════════════════════════
# Kodee API — Environment Configuration Example
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── LLM Provider: Kimi (Moonshot AI) ─────────────────────────
OPENAI_API_KEY=sk-your-kimi-key-here
OPENAI_API_BASE=https://api.moonshot.ai/v1
MODEL=kimi-k2.6

# Agent-specific model overrides (optional)
MODEL_ROUTER=kimi-k2.6
MODEL_DNS=kimi-k2.6
MODEL_BACKUP=kimi-k2.6
MODEL_MONITORING=kimi-k2.6
MODEL_HANDOFF=kimi-k2.6
MODEL_FORTIGATE=kimi-k2.6

# ─── FortiGate MCP Firewalls ──────────────────────────────────
# Multiple FortiGate firewalls can be managed.
# Generate tokens in each FortiGate: System > Administrators > REST API Admin

# Firewall Internet
FORTIOS_INTERNET_HOST=https://10.2.100.93
FORTIOS_INTERNET_API_TOKEN=your-internet-token-here
FORTIOS_INTERNET_VERIFY_SSL=false
FORTIOS_INTERNET_READONLY=true
FORTIOS_INTERNET_VDOM_FW=VDOM_FW
FORTIOS_INTERNET_VDOM_IPS=VDOM_IPS

# Firewall Datacenter
FORTIOS_DATACENTER_HOST=https://10.2.100.94
FORTIOS_DATACENTER_API_TOKEN=your-datacenter-token-here
FORTIOS_DATACENTER_VERIFY_SSL=false
FORTIOS_DATACENTER_READONLY=true
FORTIOS_DATACENTER_VDOM=root

# Firewall VPN
FORTIOS_VPN_HOST=https://10.2.100.95
FORTIOS_VPN_API_TOKEN=your-vpn-token-here
FORTIOS_VPN_VERIFY_SSL=false
FORTIOS_VPN_READONLY=true
FORTIOS_VPN_VDOM=root

# Firewall Rede Interna
FORTIOS_INTERNA_HOST=https://10.2.100.96
FORTIOS_INTERNA_API_TOKEN=your-interna-token-here
FORTIOS_INTERNA_VERIFY_SSL=false
FORTIOS_INTERNA_READONLY=true
FORTIOS_INTERNA_VDOM=root

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kodee

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant (RAG Vector DB) ───────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
JAEGER_ENDPOINT=http://localhost:4317

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_RPS=10

# ─── MCP Server ───────────────────────────────────────────────
MCP_SERVER_NAME=kodee-mcp
MCP_SERVER_VERSION=0.1.0
