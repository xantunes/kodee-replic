# =============================================================================
# LLM Configuration
# =============================================================================
# Option A: OpenAI (direct API)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.2

# Option B: Azure OpenAI (takes precedence if AZURE_OPENAI_ENDPOINT is set)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string (required)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/kodee

# Redis connection string (required)
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# Vector Database
# =============================================================================
# Qdrant server URL (required)
# QDRANT_URL=http://qdrant:6333

# Qdrant collection name for RAG documents
# QDRANT_COLLECTION=kodee_knowledge

# =============================================================================
# Monitoring
# =============================================================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
# APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Rate limit in requests per second
# RATE_LIMIT_RPS=10
