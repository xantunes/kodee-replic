# =============================================================================
# LLM Configuration
# =============================================================================
# OpenAI API key (required)
# OPENAI_API_KEY=your_openai_api_key_here

# Model name and generation parameters
# OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.2

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string (required)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/kodee

# Redis connection string (required)
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# Vector Database
# =============================================================================
# Qdrant server URL (required)
# QDRANT_URL=http://qdrant:6333

# Qdrant collection name for RAG documents
# QDRANT_COLLECTION=kodee_knowledge

# =============================================================================
# Monitoring
# =============================================================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
# APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Rate limit in requests per second
# RATE_LIMIT_RPS=10
